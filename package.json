{
  "name": "bin-days",
  "version": "2.0.0",
  "description": "Australian bin collection day API: give it an address and a date range, get back which bins go out when.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "bin-days": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "build:suburbs": "tsx scripts/build-suburbs.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE=1 vitest run test/live",
    "cli": "tsx src/cli.ts"
  },
  "author": "Daniel Garden",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "cheerio": "^1.2.0",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@fontsource-variable/outfit": "^5.3.0",
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "maplibre-gl": "^6.17.0",
    "motion": "^14.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
