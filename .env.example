# Port for the HTTP server
PORT=3000

# Identifying User-Agent sent to upstream services. Nominatim's usage policy
# requires an identifying UA with a way to contact you, e.g.
# "bin-days/2.0 (https://github.com/you/bin-days)"
BIN_DAYS_USER_AGENT=

# Optional: point at your own Nominatim instance (defaults to the public one,
# which is limited to 1 request/second).
NOMINATIM_URL=

# Optional: keep the cache in a SQLite file so it survives restarts (defaults
# to in-memory). Needs a disk that persists between deploys.
BIN_DAYS_CACHE_PATH=

# Optional: keep the cache in Upstash Redis instead (for serverless hosts such
# as Vercel, which have no persistent disk). Takes precedence over the file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: the site's public address, used for canonical links and the
# sitemap. Set it once the site has its own domain. Defaults to whatever
# address each request arrives on.
SITE_URL=
