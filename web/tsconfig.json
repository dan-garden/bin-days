{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    // Component libraries' prop types aren't written for this flag.
    "exactOptionalPropertyTypes": false
  },
  "include": ["src"]
}
